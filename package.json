{
  "name": "notice",
  "version": "2.0.0",
  "description": "荷玛诗国际花园用电充值系统监控：定时抓取电表余额与用电数据，余额低于阈值邮件预警，前端实时看板（中英双语、三档主题）",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently -n server,ui -c blue,green \"node index.js\" \"cd frontend && pnpm run dev\"",
    "build": "cd frontend && pnpm run build",
    "postinstall": "cd frontend && pnpm install"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dayjs": "^1.11.19",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-schedule": "^2.1.0",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
