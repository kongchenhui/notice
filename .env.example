# 服务端口
PORT=30000
NODE_ENV=production

# 数据库文件路径
DB_PATH=./data/electricity.db

# SMTP 邮件配置 (QQ邮箱)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_email@qq.com
SMTP_PASS=your_authorization_code
EMAIL_FROM=your_qq_email@qq.com
EMAIL_TO=recipient@qq.com

# 通知规则
NOTICE_THRESHOLD=20
NOTICE_INTERVAL_HOURS=6
NOTICE_START_HOUR=7
NOTICE_END_HOUR=23
